# ---- QueLess API ----
PORT=4000
NODE_ENV=development
#Piyush@2024
# Postgres (with PostGIS) connection string.
#  - Local:     postgres://postgres:postgres@localhost:5432/queless
#  - Supabase:  Project → Connect → "Session pooler" (or Direct) URI. NOT the transaction pooler (port 6543):
#               realtime uses LISTEN/NOTIFY, which needs a session connection.
DATABASE_URL=
# auto = SSL for remote hosts, off for localhost
DATABASE_SSL=auto

# Signs the session cookie. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The web app URL(s), comma separated (CORS + CSRF origin check)
FRONTEND_URL=http://localhost:5173
# true ONLY if web and API are on different sites in production (e.g. *.vercel.app + *.onrender.com)
COOKIE_CROSS_SITE=false

# Optional: email alerts through https://resend.com (empty = emails are only logged)
RESEND_API_KEY=
EMAIL_FROM=QueLess <onboarding@resend.dev>

# Background jobs (auto no-show every 15 s, close day 23:59 IST). Enable on ONE instance.
JOBS_ENABLED=true
